{
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(node --experimental-strip-types --test *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "(Edit|Write|MultiEdit)",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q '\"file_path\".*packages/shiori-cli/src/'; then pnpm --filter @berlysia/shiori run lint:boundaries 2>&1 | tail -5; fi",
            "timeout": 10000,
            "run_in_background": false
          }
        ]
      }
    ]
  }
}
